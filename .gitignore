#git忽略规则
# ==============================================
# Python 通用忽略规则
# ==============================================
# Python字节码文件
__pycache__/
*.py[cod]
*$py.class

# 分发/打包文件
dist/
build/
*.egg-info/
*.egg
*.spec

# 虚拟环境
venv/
env/
ENV/
.venv/
# 日志文件
*.log
logs/

# 临时文件
*.tmp
*.temp
*.swp
*.swo

# ==============================================
# PyCharm/IntelliJ IDEA 忽略规则
# ==============================================
.idea/
*.iml
*.iws
*.ipr
out/

# ==============================================
# 本项目特定忽略规则
# ==============================================
# 用户本地配置文件（可选，如果你想同步配置就注释掉这行）
config/*.json
.gitignore
# 个人开发笔记
项目记事本*.txt
项目记事本*.md!/test.py
/项目记事本markdown.md
/test.py


CST_Test/
!/config/Windows系统默认快捷键方案.json
!/config/测试快捷键方案.json
